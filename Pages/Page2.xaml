<Page x:Class="Pr14.Pages.Page2"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Pr14.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Авторизация">

    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Background="#2196F3" Padding="20">
            <TextBlock Text="Авторизация" 
                   FontSize="24" 
                   Foreground="White" 
                   FontWeight="Bold"
                   HorizontalAlignment="Center"/>
        </Border>

        <!-- Форма входа -->
        <Border Grid.Row="1" 
            Background="White" 
            Width="350" 
            Height="400"
            HorizontalAlignment="Center" 
            VerticalAlignment="Center"
            BorderBrush="#DDDDDD"
            BorderThickness="1">
            <StackPanel Margin="30">

                <!-- Логин -->
                <TextBlock Text="Логин:" 
                       FontSize="14" 
                       Margin="0,20,0,5"
                       Foreground="#333333"/>
                <TextBox x:Name="LoginEnter" 
                     Height="30" 
                     Padding="5"
                     BorderBrush="#CCCCCC"
                     BorderThickness="1"/>

                <!-- Пароль -->
                <TextBlock Text="Пароль:" 
                       FontSize="14" 
                       Margin="0,20,0,5"
                       Foreground="#333333"/>
                <PasswordBox x:Name="PasswordEnter" 
                         Height="30" 
                         Padding="5"
                         BorderBrush="#CCCCCC"
                         BorderThickness="1"
                         Margin="0,0,0,30"/>

                <!-- Кнопка входа -->
                <Button Content="Войти" 
                    FontSize="16" 
                    Height="40"
                    Background="#2196F3"
                    Foreground="White"
                    BorderThickness="0"
                    Margin="0,0,0,20"
                    Click="Button_Click_1"
                    Cursor="Hand"/>

                <!-- Разделитель -->
                <Line X1="0" Y1="0" X2="290" Y2="0" 
                  Stroke="#DDDDDD" 
                  StrokeThickness="1" 
                  HorizontalAlignment="Center"
                  Margin="0,10"/>

                <!-- Регистрация -->
                <StackPanel HorizontalAlignment="Center" Margin="0,15,0,0">
                    <TextBlock Text="Нет аккаунта?" 
                           FontSize="13" 
                           Foreground="#666666"
                           HorizontalAlignment="Center"/>
                    <Button Content="Зарегистрироваться" 
                        FontSize="13" 
                        Background="Transparent" 
                        Foreground="#2196F3" 
                        BorderThickness="0"
                        Margin="0,5,0,0"
                        Click="Button_Click"
                        Cursor="Hand"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Кнопка назад -->
        <Button x:Name="GoBack" 
            Content="← Назад" 
            HorizontalAlignment="Left" 
            VerticalAlignment="Top" 
            Margin="20" 
            FontSize="14" 
            Background="#E0E0E0" 
            Foreground="#333333" 
            BorderThickness="0"
            Padding="15,8"
            Click="GoBack_Click"
            Cursor="Hand"/>
    </Grid>
</Page>
