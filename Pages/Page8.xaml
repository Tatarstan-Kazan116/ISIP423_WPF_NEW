<Page x:Class="Pr14.Pages.Page8"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Pr14.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="800"
      Title="Покупка">

    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="20">
            <TextBlock Text="Покупка билета" 
                   FontSize="20" 
                   Foreground="White" 
                   FontWeight="Bold"
                   HorizontalAlignment="Center"/>
        </Border>

        <!-- Карточка заказа -->
        <Border Grid.Row="1" 
            Background="White" 
            Width="450" 
            Height="500"
            HorizontalAlignment="Center" 
            VerticalAlignment="Center"
            BorderBrush="#DDDDDD"
            BorderThickness="1">
            <StackPanel Margin="30">

                <!-- Заголовок -->
                <TextBlock Text="Детали заказа" 
                       FontSize="18" 
                       FontWeight="Bold"
                       Foreground="#2C3E50"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,25"/>

                <!-- Фильм -->
                <StackPanel Orientation="Horizontal" Margin="0,10,0,15">
                    <TextBlock Text="Фильм: " 
                           FontSize="14" 
                           FontWeight="Bold"
                           Foreground="#333333"
                           Width="100"/>
                    <TextBlock x:Name="FilmText" 
                           Text="" 
                           FontSize="14" 
                           Foreground="#666666"
                           TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Зал -->
                <StackPanel Orientation="Horizontal" Margin="0,10,0,15">
                    <TextBlock Text="Зал: " 
                           FontSize="14" 
                           FontWeight="Bold"
                           Foreground="#333333"
                           Width="100"/>
                    <TextBlock x:Name="HallText" 
                           Text="" 
                           FontSize="14" 
                           Foreground="#666666"/>
                </StackPanel>

                <!-- Место -->
                <StackPanel Orientation="Horizontal" Margin="0,10,0,15">
                    <TextBlock Text="Место: " 
                           FontSize="14" 
                           FontWeight="Bold"
                           Foreground="#333333"
                           Width="100"/>
                    <TextBlock x:Name="SeatText" 
                           Text="" 
                           FontSize="14" 
                           Foreground="#666666"/>
                </StackPanel>

                <!-- Ряд -->
                <StackPanel Orientation="Horizontal" Margin="0,10,0,15">
                    <TextBlock Text="Ряд: " 
                           FontSize="14" 
                           FontWeight="Bold"
                           Foreground="#333333"
                           Width="100"/>
                    <TextBlock x:Name="LineText" 
                           Text="" 
                           FontSize="14" 
                           Foreground="#666666"/>
                </StackPanel>

                <!-- Время -->
                <StackPanel Orientation="Horizontal" Margin="0,10,0,15">
                    <TextBlock Text="Время: " 
                           FontSize="14" 
                           FontWeight="Bold"
                           Foreground="#333333"
                           Width="100"/>
                    <TextBlock x:Name="TimeText" 
                           Text="" 
                           FontSize="14" 
                           Foreground="#666666"/>
                </StackPanel>

                <!-- Разделитель -->
                <Line X1="0" Y1="0" X2="390" Y2="0" 
                  Stroke="#DDDDDD" 
                  StrokeThickness="1" 
                  HorizontalAlignment="Center"
                  Margin="0,15"/>

                <!-- Итого -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,25">
                    <TextBlock Text="Итого: " 
                           FontSize="16" 
                           FontWeight="Bold"
                           Foreground="#333333"/>
                    <TextBlock x:Name="PriceText" 
                           Text="" 
                           FontSize="18" 
                           FontWeight="Bold"
                           Foreground="#2C3E50"/>
                </StackPanel>

                <!-- Кнопка купить -->
                <Button Content="Подтвердить покупку" 
                    Height="45" 
                    Width="250"
                    FontSize="16" 
                    Background="#2C3E50"
                    Foreground="White"
                    BorderThickness="0"
                    Click="Button_Click"
                    Cursor="Hand"/>
            </StackPanel>
        </Border>

        <!-- Кнопка назад -->
        <Button x:Name="GoBack" 
            Content="← Назад" 
            HorizontalAlignment="Left" 
            VerticalAlignment="Top" 
            Margin="20,20,0,0" 
            FontSize="14" 
            Background="#E0E0E0" 
            Foreground="#333333" 
            BorderThickness="0"
            Padding="15,8"
            Click="GoBack_Click"
            Cursor="Hand"/>
    </Grid>
</Page>
