<Page x:Class="Pr14.Pages.Page5"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Pr14.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="550" d:DesignWidth="800"
      Title="Подробная информация о фильме">

    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="20">
            <TextBlock Text="Информация о фильме" 
                   FontSize="20" 
                   Foreground="White" 
                   FontWeight="Bold"
                   HorizontalAlignment="Center"/>
        </Border>

        <!-- Карточка фильма -->
        <Border Grid.Row="1" 
            Background="White" 
            Width="400" 
            Height="500"
            HorizontalAlignment="Center" 
            VerticalAlignment="Center"
            BorderBrush="#DDDDDD"
            BorderThickness="1">
            <StackPanel Margin="25">

                <!-- Изображение -->
                <Image Height="200" 
                   UseLayoutRounding="False" 
                   Source="{Binding ImagePath}" 
                   Width="350" 
                   Stretch="UniformToFill"
                   Margin="0,0,0,20"/>

                <!-- Название -->
                <TextBlock Text="{Binding Name}" 
                       FontSize="22" 
                       FontWeight="Bold"
                       Foreground="#333333"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,0,0,15"/>

                <!-- Описание -->
                <TextBlock Text="{Binding Description}" 
                       FontSize="14" 
                       Foreground="#666666"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,0,0,15"/>

                <!-- Возраст -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                    <TextBlock Text="Возраст: " 
                           FontSize="14" 
                           FontWeight="Bold"
                           Foreground="#333333"/>
                    <TextBlock x:Name="AgeText" 
                           Text="" 
                           FontSize="14" 
                           Foreground="#666666"/>
                </StackPanel>

                <!-- Жанр -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <TextBlock Text="Жанр: " 
                           FontSize="14" 
                           FontWeight="Bold"
                           Foreground="#333333"/>
                    <TextBlock x:Name="fGenre" 
                           Text="" 
                           FontSize="14" 
                           Foreground="#666666"/>
                </StackPanel>

                <!-- Кнопка купить -->
                <Button x:Name="TicketBuy" 
                    Content="Купить билет" 
                    Height="45" 
                    Width="200"
                    FontSize="16" 
                    Background="#2C3E50"
                    Foreground="White"
                    BorderThickness="0"
                    Margin="0,0,0,0"
                    Click="TicketBuy_Click"
                    Cursor="Hand"/>
            </StackPanel>
        </Border>

        <!-- Кнопка назад -->
        <Button x:Name="GoBack" 
            Content="← Назад" 
            HorizontalAlignment="Left" 
            VerticalAlignment="Top" 
            Margin="20,20,0,0" 
            FontSize="14" 
            Background="#E0E0E0" 
            Foreground="#333333" 
            BorderThickness="0"
            Padding="15,8"
            Click="GoBack_Click"
            Cursor="Hand"/>
    </Grid>
</Page>
