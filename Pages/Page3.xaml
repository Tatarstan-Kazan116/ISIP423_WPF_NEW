<Page x:Class="Pr14.Pages.Page3"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Pr14.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Регистрация">

    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="20">
            <TextBlock Text="Регистрация" 
                   FontSize="24" 
                   Foreground="White" 
                   FontWeight="Bold"
                   HorizontalAlignment="Center"/>
        </Border>

        <!-- Форма регистрации -->
        <Border Grid.Row="1" 
            Background="White" 
            Width="400" 
            Height="500"
            HorizontalAlignment="Center" 
            VerticalAlignment="Center"
            BorderBrush="#DDDDDD"
            BorderThickness="1">
            <StackPanel Margin="30">

                <!-- Почта -->
                <TextBlock Text="Почта:" 
                       FontSize="14" 
                       Margin="0,10,0,5"
                       Foreground="#333333"/>
                <TextBox x:Name="LoginEnter" 
                     Height="30" 
                     Padding="5"
                     BorderBrush="#CCCCCC"
                     BorderThickness="1"
                     LostFocus="LoginEnter_LostFocus"/>

                <!-- Пароль -->
                <TextBlock Text="Пароль:" 
                       FontSize="14" 
                       Margin="0,10,0,5"
                       Foreground="#333333"/>
                <PasswordBox x:Name="PasswordEnter" 
                         Height="30" 
                         Padding="5"
                         BorderBrush="#CCCCCC"
                         BorderThickness="1"
                         LostFocus="PasswordEnter_LostFocus"/>

                <!-- ФИО -->
                <TextBlock Text="ФИО:" 
                       FontSize="14" 
                       Margin="0,10,0,5"
                       Foreground="#333333"/>
                <TextBox x:Name="FIOEnter" 
                     Height="30" 
                     Padding="5"
                     BorderBrush="#CCCCCC"
                     BorderThickness="1"
                     LostFocus="FIOEnter_LostFocus"/>

                <!-- Возраст -->
                <TextBlock Text="Возраст:" 
                       FontSize="14" 
                       Margin="0,10,0,5"
                       Foreground="#333333"/>
                <TextBox x:Name="AgeEnter" 
                     Height="30" 
                     Padding="5"
                     BorderBrush="#CCCCCC"
                     BorderThickness="1"
                     LostFocus="AgeEnter_LostFocus"/>

                <!-- Телефон -->
                <TextBlock Text="Телефон:" 
                       FontSize="14" 
                       Margin="0,10,0,5"
                       Foreground="#333333"/>
                <TextBox x:Name="PhoneEnter" 
                     Height="30" 
                     Padding="5"
                     BorderBrush="#CCCCCC"
                     BorderThickness="1"
                     LostFocus="PhoneEnter_LostFocus"/>

                <!-- Кнопка регистрации -->
                <Button x:Name="Registr" 
                    Content="Зарегистрироваться" 
                    FontSize="16" 
                    Height="40"
                    Background="#2C3E50"
                    Foreground="White"
                    BorderThickness="0"
                    Margin="0,20,0,0"
                    FontWeight="Bold"
                    Click="Registr_Click"
                    Cursor="Hand"/>
            </StackPanel>
        </Border>

        <!-- Кнопка входа -->
        <Button VerticalAlignment="Bottom" 
            HorizontalAlignment="Left" 
            Margin="20" 
            Content="← Войти" 
            FontSize="14" 
            Background="#E0E0E0" 
            Foreground="#333333" 
            BorderThickness="0"
            Padding="15,8"
            Click="Button_Click"
            Cursor="Hand"/>
    </Grid>
</Page>
