<Page x:Class="Pr14.Pages.Page4"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Pr14.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="800"
      Title="Контактная информация">

    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="20">
            <TextBlock Text="Кинотеатр Львиная Душа" 
                   FontSize="20" 
                   Foreground="White" 
                   FontWeight="Bold"
                   HorizontalAlignment="Center"/>
        </Border>

        <!-- Информация о пользователе -->
        <Border Grid.Row="1" 
            Background="White" 
            Width="400" 
            Height="350"
            HorizontalAlignment="Center" 
            VerticalAlignment="Top"
            Margin="0,30,0,0"
            BorderBrush="#DDDDDD"
            BorderThickness="1" x:Name="UsInfo">
            <StackPanel Margin="30">

                <!-- Заголовок профиля -->
                <TextBlock Text="Профиль пользователя" 
                       FontSize="18" 
                       FontWeight="Bold"
                       Foreground="#2C3E50"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

                <!-- ФИО -->
                <StackPanel Orientation="Horizontal" Margin="0,10,0,10">
                    <TextBlock Text="ФИО: " 
                           FontSize="14" 
                           FontWeight="Bold"
                           Foreground="#333333"
                           Width="120"/>
                    <TextBlock x:Name="FIOuser" 
                           Text="" 
                           FontSize="14" 
                           Foreground="#666666"/>
                </StackPanel>

                <!-- Возраст -->
                <StackPanel Orientation="Horizontal" Margin="0,10,0,10">
                    <TextBlock Text="Возраст: " 
                           FontSize="14" 
                           FontWeight="Bold"
                           Foreground="#333333"
                           Width="120"/>
                    <TextBlock x:Name="AGEuser" 
                           Text="" 
                           FontSize="14" 
                           Foreground="#666666"/>
                </StackPanel>

                <!-- E-mail -->
                <StackPanel Orientation="Horizontal" Margin="0,10,0,10">
                    <TextBlock Text="E-mail: " 
                           FontSize="14" 
                           FontWeight="Bold"
                           Foreground="#333333"
                           Width="120"/>
                    <TextBlock x:Name="EMAILuser" 
                           Text="" 
                           FontSize="14" 
                           Foreground="#666666"/>
                </StackPanel>

                <!-- Телефон -->
                <StackPanel Orientation="Horizontal" Margin="0,10,0,10">
                    <TextBlock Text="Телефон: " 
                           FontSize="14" 
                           FontWeight="Bold"
                           Foreground="#333333"
                           Width="120"/>
                    <TextBlock x:Name="NUMBERuser" 
                           Text="" 
                           FontSize="14" 
                           Foreground="#666666"/>
                </StackPanel>

                <!-- Разделитель -->
                <Line X1="0" Y1="0" X2="340" Y2="0" 
                  Stroke="#DDDDDD" 
                  StrokeThickness="1" 
                  HorizontalAlignment="Center"
                  Margin="0,15"/>

                <!-- Билеты -->
                <StackPanel Margin="0,15,0,0">
                    <TextBlock Text="Активные билеты:" 
                           FontSize="14" 
                           FontWeight="Bold"
                           Foreground="#333333"
                           Margin="0,0,0,10"/>
                    <TextBlock x:Name="TicketUsers" 
                           Text="Нет активных билетов" 
                           FontSize="14" 
                           Foreground="#666666"
                           FontStyle="Italic"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Кнопка назад -->
        <Button x:Name="GoBack" 
            Content="← Назад" 
            HorizontalAlignment="Left" 
            VerticalAlignment="Bottom" 
            Margin="30" 
            FontSize="14" 
            Background="#E0E0E0" 
            Foreground="#333333" 
            BorderThickness="0"
            Padding="20,10"
            Click="GoBack_Click"
            Cursor="Hand"/>
    </Grid>
</Page>
